datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Article {
  id         String   @id @default(cuid())
  title      String
  category   String
  author     String   @default("Admin Xstronomy")
  date       String
  readTime   String?  @default("4 menit baca")
  coverImage String?
  summary    String   @db.Text
  content    String   @db.Text
  tags       String[] @default([])
  featured   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("articles")
}

model CalculationHistory {
  id              String   @id @default(cuid())
  title           String?
  expression      String
  variables       Json?
  result          Float?
  formattedResult String?
  outputUnit      String?
  createdAt       DateTime @default(now())

  @@map("calculation_histories")
}

model QuizQuestion {
  id            String   @id @default(cuid())
  grade         Int      @default(12) // 10, 11, 12
  topic         String   // e.g. "Listrik Statis & Searah", "Medan Magnet", "Relativitas Khusus", "Fisika Kuantum", "Fisika Inti"
  question      String   @db.Text
  questionLatex String?  @db.Text
  options       Json     // Array of { text: string, latex?: string, isCorrect: boolean }
  explanation   String   @db.Text
  difficulty    String   @default("Sedang") // "Mudah" | "Sedang" | "Tantangan"
  formulaHint   String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("quiz_questions")
}

model CustomFormula {
  id           String   @id @default(cuid())
  title        String
  expression   String
  latex        String?
  detectedUnit String?
  variables    Json?    // Array of { key, label, unit, default }
  category     String   @default("Kustom")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("custom_formulas")
}
